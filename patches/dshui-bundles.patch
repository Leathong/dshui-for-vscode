+import type { UserTextInjected } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { UserTextRegistry } from '../../ui-conversation/src/client/conversation/user-text-registry.ts'
+import { UserText, PlainUserText } from '../../ui-conversation/src/client/user-text/UserText.tsx'
+import { collapseWhitespaceRule, trimWhitespaceRule } from '../../ui-conversation/src/client/user-text/whitespace-rules.ts'
+import { markdownLinkRule, filePathAndLine, userLinkDestination } from '../src/client/chat/user-link-rule.ts'
+import { UserLink, type UserLinkInjected } from '../src/client/chat/UserLink.tsx'
+import { dshuiOpenPath } from '../src/client/dshui-open.ts'
+
+afterEach(cleanup)
+
+type RenderSeats = PropsRenderSlots<'conversation.approval.detail'> & PropsRenderFactories
+
+/** Mount the user-text pipeline with the dshui link rule and its renderer. */
+async function bench() {
+  const runtime = await SlotTestRuntime.create()
+  onTestFinished(() => runtime.dispose())
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
+  locale.register('common', { en: commonEn, zh: commonEn })
+  locale.setLocale('en')
+  runtime.slots.installLocale(locale)
+  const openFile = vi.fn<UserLinkInjected['openFile']>()
+  await runtime.mount({ inject: ['slots'], apply: (ctx) => {
+    const userText = new UserTextRegistry(ctx)
+    for (const rule of [markdownLinkRule, collapseWhitespaceRule, trimWhitespaceRule]) userText.register(rule)
+    ctx.slots.registerFactory({
+      name: 'conversation.user.text', scope: 'session',
+      children: { 'conversation.user.text.node': { kind: 'keyed', scope: 'session', inline: true } },
+      inject: (): UserTextInjected => ({
+        hooks: { userTextRevision: {
+          getSnapshot: () => userText.getSnapshot(), subscribe: listener => userText.subscribe(listener),
+        } },
+        createUserTextEvaluator: () => userText.createEvaluator(),
+        reportTransformFailure: (error: unknown): never => { throw error },
+      }),
+    }, UserText)
+    ctx.slots.register({ name: 'conversation.user.text.node', key: 'text' }, PlainUserText)
+    ctx.slots.register({ name: 'conversation.user.text.node', key: 'link', inject: () => ({ openFile }) }, UserLink)
+  } })
+  await runtime.sessions.add({ id: 'user-link' })
+  const session = runtime.sessions.retainFor(runtime.ctx, SessionId('user-link'))
+  const captured: { seats?: RenderSeats; setContent?: (content: ReactNode) => void } = {}
+  await runtime.root.declare({ 'conversation.approval.detail': { kind: 'single', scope: 'session' } },
+    function TestRoot(props) {
+      const [content, setContent] = useState<ReactNode>(null)
+      captured.seats = props
+      captured.setContent = setContent
+      return content
+    })
+  const view = runtime.renderRoot()
+  const { seats, setContent } = captured
+  if (seats === undefined || setContent === undefined) throw new Error('user link fixture root did not render')
+  const { SessionProvider } = seats
+  const render = (text: string, interactive = true) => {
+    const node = seats.renderFactorySlot('conversation.user.text', { text, facts: {}, interactive })
+    act(() => { setContent(<SessionProvider session={session}>{node}</SessionProvider>) })
+    return view
+  }
+  return { runtime, openFile, render }
+}
+
+describe('user text markdown links', () => {
+  it('claims markdown links and renders file destinations as open gestures with their line', async () => {
+    const b = await bench()
+    const container = b.render('see [anchor](lib/a.dart#L268) and [suffix](lib/b.dart:94)')
+    fireEvent.click(container.getByRole('button', { name: 'anchor' }))
+    expect(b.openFile).toHaveBeenCalledWith('lib/a.dart', 268)
+    fireEvent.click(container.getByRole('button', { name: 'suffix' }))
+    expect(b.openFile).toHaveBeenCalledWith('lib/b.dart', 94)
+  })
+
+  it('opens a file link without a line at the file top', async () => {
+    const b = await bench()
+    const container = b.render('see [plain](lib/a.dart)')
+    fireEvent.click(container.getByRole('button', { name: 'plain' }))
+    expect(b.openFile).toHaveBeenCalledWith('lib/a.dart', undefined)
+  })
+
+  it('keeps allowlisted absolute URLs as anchors and non-interactive text as plain labels', async () => {
+    const b = await bench()
+    const container = b.render('read [docs](https://example.com/x) or [mail](mailto:a@example.com)')
+    expect(container.getByRole('link', { name: 'docs' }).getAttribute('target')).toBe('_blank')
+    expect(container.getByRole('link', { name: 'mail' }).getAttribute('target')).toBeNull()
+    const inert = b.render('see [plain](lib/a.dart)', false)
+    expect(inert.queryAllByRole('button')).toHaveLength(0)
+    expect(inert.getByText('plain')).toBeTruthy()
+  })
+
+  it('leaves destinations outside the allowlist as literal text', async () => {
+    const b = await bench()
+    const container = b.render('fetch [spec](ftp://example.com/spec)')
+    expect(container.queryAllByRole('button')).toHaveLength(0)
+    expect(container.queryAllByRole('link')).toHaveLength(0)
+    expect(container.container.textContent).toContain('[spec](ftp://example.com/spec)')
+  })
+})
+
+describe('user link destination parsing', () => {
+  it.each([
+    ['lib/a.dart', { path: 'lib/a.dart' }],
+    ['lib/a.dart#L10', { path: 'lib/a.dart', line: 10 }],
+    ['lib/a.dart#L10-L20', { path: 'lib/a.dart', line: 10 }],
+    ['lib/a.dart:94', { path: 'lib/a.dart', line: 94 }],
+    ['lib/a.dart:94-120', { path: 'lib/a.dart', line: 94 }],
+    ['lib/a.dart:94–120', { path: 'lib/a.dart', line: 94 }],
+  ])('splits the line reference off %s', (raw, expected) => {
+    expect(filePathAndLine(raw)).toEqual(expected)
+  })
+
+  it('classifies protocols and keeps home-relative destinations in their Host spelling', () => {
+    expect(userLinkDestination('https://example.com')).toEqual({ kind: 'external', href: 'https://example.com', newTab: true })
+    expect(userLinkDestination('mailto:a@example.com')).toEqual({ kind: 'external', href: 'mailto:a@example.com', newTab: false })
+    expect(userLinkDestination('ftp://example.com')).toBeNull()
+    expect(dshuiOpenPath('/work/repo', 'src/notes.md')).toBe('/work/repo/src/notes.md')
+    expect(dshuiOpenPath('/work/repo', '/etc/hosts')).toBe('/etc/hosts')
+    expect(dshuiOpenPath('/work/repo', './~/.dsh/config.yml')).toBe('~/.dsh/config.yml')
+  })
+})
