diff --git a/packages/client/ui-conversation/src/client/skeleton/dshui-scope.ts b/packages/client/ui-conversation/src/client/skeleton/dshui-scope.ts
new file mode 100644
index 0000000000..ec9e8ea4ae
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/skeleton/dshui-scope.ts
@@ -0,0 +1,16 @@
+/**
+ * The dshui workspace scope: the VS Code workspace root published by the
+ * dshui host plugin as `window.__DSHUI_WORKSPACE__` (with a fallback to the
+ * boot URL's `dshui_workspace` query parameter). When set, the conversation
+ * treats that Workspace as fixed: no picker, hero chrome pinned to the bottom
+ * like the docked composer.
+ */
+export const DSHUI_SCOPE = ((): string => {
+  // Guard: this module is also imported by Node-env specs (window undefined).
+  if (typeof window === 'undefined') return ''
+  const global = (window as unknown as { __DSHUI_WORKSPACE__?: unknown }).__DSHUI_WORKSPACE__
+  const fromGlobal = typeof global === 'string' ? global : ''
+  const value = fromGlobal !== '' ? fromGlobal : (new URLSearchParams(window.location.search).get('dshui_workspace') ?? '')
+  if (value === '') return ''
+  try { return decodeURIComponent(value) } catch { return value }
+})()
