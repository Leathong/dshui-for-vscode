+/**
+ * dshui patch: expand a leading home prefix in a path that arrived from the
+ * Client. The browser cannot read the Host account home, so a link destination
+ * that names it (`~/.dsh/...`) keeps its `~` spelling until it reaches the Host;
+ * expanding here precedes `resolve`, which would otherwise staple the `~`
+ * segment to the server's working directory.
+ * @param path - requested path, possibly `~`, `~/…`, or `~\…`.
+ * @returns the path with the home prefix expanded, or the input when absent.
+ */
+function dshuiHomePath(path: string): string {
+  if (path === '~') return homedir()
+  if (path.startsWith('~/') || path.startsWith('~\\')) return join(homedir(), path.slice(2))
+  return path
+}
