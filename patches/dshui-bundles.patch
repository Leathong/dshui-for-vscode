+/**
+ * The dshui delete action: a `sidebar.workspaces.session.menu.item` row and a
+ * `sidebar.workspaces.session.row.action` button over one injected behavior.
+ * Deletion belongs to the VS Code extension host, which removes the Session's
+ * persisted log directory; the client posts the request through the webview
+ * shell and hides the row locally because dsh has no Host echo into the
+ * Session list (see the browser's deleted-sessions observable).
+ */
+import {
+  IconTrashOutlineRegular, MenuItemButton, Tooltip,
+} from '@deepseek-ai/dsh-client-ui-primitives'
+import type {
+  DeleteSessionInjected, SessionMenuItemProps, SessionRowActionProps,
+} from '../contract/slots.ts'
+import css from '../rows/Rows.module.css'
+
+/**
+ * Menu row (order 500): delete this Session's log through the extension host.
+ * @param props - owner share, the delete share, and the menu open state.
+ * @returns the row.
+ */
+export function DeleteSessionMenuItem({
+  sessionId, useMenuOpenState, deleteSession, t,
+}: SessionMenuItemProps<DeleteSessionInjected>) {
+  const [, setMenuOpen] = useMenuOpenState()
+  return (
+    <MenuItemButton
+      danger
+      icon={<IconTrashOutlineRegular size={14} />}
+      onSelect={() => {
+        setMenuOpen(false)
+        deleteSession(sessionId)
+      }}
+    >
+      {t('menu.deleteSession')}
+    </MenuItemButton>
+  )
+}
+
+/**
+ * Hover button (order 300): delete this Session's log through the extension host.
+ * @param props - owner share and the delete share.
+ * @returns the button.
+ */
+export function DeleteSessionRowButton({
+  sessionId, deleteSession, t,
+}: SessionRowActionProps<DeleteSessionInjected>) {
+  return (
+    <Tooltip label={t('actions.delete')} side="bottom" align="end" delayMs={500}>
+      <button
+        type="button"
+        className={css.iconButton}
+        aria-label={t('menu.deleteSession')}
+        onClick={() => { deleteSession(sessionId) }}
+      >
+        <IconTrashOutlineRegular size={14} />
+      </button>
+    </Tooltip>
+  )
+}
