+/**
+ * dshui overlay: install the user-text link rule and its inline renderer.
+ *
+ * The rule is a global registry contribution (every Session's user text) and
+ * the renderer is a keyed entry under the Conversation-owned
+ * `conversation.user.text.node` slot, so both leave with this plugin fiber.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import type { UserTextNodeProps } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { dshuiClickOrigin, dshuiOpenPath } from '../dshui-open.ts'
+import { markdownLinkRule } from './user-link-rule.ts'
+import { UserLink, type UserLinkInjected } from './UserLink.tsx'
+
+/**
+ * Register the markdown-link rule and its renderer.
+ * @param ctx - Client root context of the Chat plugin.
+ */
+export function registerUserLinks(ctx: Context): void {
+  ctx.effect(
+    () => ctx.uiConversation.userText.register(markdownLinkRule),
+    'dshui: user-text markdown link rule',
+  )
+  ctx.slots.inject('conversation.user.text.node', function* () {
+    yield ctx.slots.register({
+      name: 'conversation.user.text.node',
+      key: 'link',
+      priority: 100,
+      inject: (sessionId: UserTextNodeProps<'link'>['sessionId']): UserLinkInjected => ({
+        openFile: (path, line) => {
+          const cwd = ctx.sessions.list.getSnapshot().byId[sessionId]?.cwd
+          const origin = dshuiClickOrigin()
+          ctx.remote.session.openWorkspacePath({
+            path: dshuiOpenPath(cwd, path),
+            ...(origin === undefined ? {} : { dshuiOrigin: origin }),
+            ...(line === undefined ? {} : { dshuiLine: line }),
+          }).then((result) => {
+            if (!result.ok) console.error(`[dshui] link open failed: ${result.error.message}`)
+          }, (error: unknown) => {
+            console.error('[dshui] link open request failed:', error)
+          })
+        },
+      }),
+    }, UserLink)
+  })
+}
