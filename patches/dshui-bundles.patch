index 0000000000..61e170079e
--- /dev/null
+++ b/packages/client/ui-chat/src/client/dshui-open.ts
@@ -0,0 +1,46 @@
+/**
+ * dshui overlay: the click origin and Host-facing path spelling shared by the
+ * Chat file-open seat (`apply.ts`) and the user-text link renderer.
+ *
+ * @module @deepseek-ai/dsh-client-ui-chat/dshui-open
+ */
+import { resolveWorkspacePath } from '@deepseek-ai/dsh-util-workspace-path'
+
+/**
+ * The VS Code workspace of the window the open click happens in, published by
+ * the dshui host plugin as `window.__DSHUI_WORKSPACE__` (with a fallback to
+ * the boot URL's `dshui_workspace` query parameter). Attached to
+ * `openWorkspacePath` as `dshuiOrigin` so the Host opens the file in this
+ * window even when the path's longest-prefix owner is another window.
+ * @returns the scope path, or undefined when neither source is set.
+ */
+export function dshuiClickOrigin(): string | undefined {
+  if (typeof window === 'undefined') return undefined
+  const global = (window as typeof window & { __DSHUI_WORKSPACE__?: unknown }).__DSHUI_WORKSPACE__
+  if (typeof global === 'string' && global !== '') return global
+  const param = new URLSearchParams(window.location.search).get('dshui_workspace')
+  if (param === null || param === '') return undefined
+  try {
+    const decoded = decodeURIComponent(param)
+    return decoded === '' ? undefined : decoded
+  } catch {
+    return param
+  }
+}
+
+/**
+ * The Host-facing spelling of one file-link destination. A destination that
+ * names the account home (`~`, `~/…`, `~\…`) is not workspace-relative:
+ * leading `./` and `../` segments cannot rise above that anchor, so they are
+ * dropped, and the `~` spelling travels to the Host, the only side that knows
+ * the home directory. Joining such a destination onto the Session cwd instead
+ * produces a literal `~` directory under the workspace.
+ * @param cwd - Session workspace root, when the Session is known.
+ * @param path - the link destination, before Host resolution.
+ * @returns the path to send with `openWorkspacePath`.
+ */
+export function dshuiOpenPath(cwd: string | undefined, path: string): string {
+  const anchored = path.replace(/^(?:\.{1,2}[/\\])+/, '')
+  if (anchored === '~' || anchored.startsWith('~/') || anchored.startsWith('~\\')) return anchored
+  return resolveWorkspacePath(cwd, path)
+}
