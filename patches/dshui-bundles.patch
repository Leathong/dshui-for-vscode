+// ── dshui patch: route "open path" gestures into the hosting VS Code ──
+// The dsh web UI opens paths with the OS default handler; a browser app has no
+// idea an IDE is hosting it. These helpers first ask the hosting VS Code (via
+// a local open bridge) to open the path — no OS external-scheme confirmation
+// popup — then fall back to the `code` CLI, then to a `vscode://file` URL.
+
+/** dshui patch: process liveness via signal 0. */
+function dshuiPidAlive(pid: number): boolean {
+  try { process.kill(pid, 0); return true } catch (error) { return error !== null && error !== undefined && (error as NodeJS.ErrnoException).code === 'EPERM' }
+}
+
+/** dshui patch: bridge lease liveness — the pid alone is insufficient because
+ * the OS can recycle it after the owning window dies. */
+function dshuiBridgeLeaseLive(entry: { lastSeen: number }): boolean {
+  return Date.now() - entry.lastSeen <= 45000
+}
+
+/** dshui patch: absolute path as a `vscode://file/` URL (fallback opener). */
+function dshuiVscodeFileUrl(path: string): string {
+  return 'vscode://file/' + path.split('/').map(segment => encodeURIComponent(segment)).join('/')
+}
+
+/** dshui patch: normalize the click origin attached by the client bundle. */
+function dshuiOriginWorkspace(origin: string): string | null {
+  if (typeof origin !== 'string' || origin === '') return null
+  let workspace = origin
+  while (workspace.length > 1 && (workspace.endsWith('/') || workspace.endsWith('\\'))) workspace = workspace.slice(0, -1)
+  return workspace === '' ? null : workspace
+}
+
+/** dshui patch: the bridge registered by the window with the exact workspace path. */
+async function dshuiBridgeForWorkspace(workspace: string): Promise<{ endpoint: string; token: string } | null> {
+  const bridgesFile = process.env.DSHUI_BRIDGES_FILE
+  if (!bridgesFile) return null
+  let fsModule: typeof import('node:fs'), raw: string
+  try {
+    fsModule = await import('node:fs')
+    raw = fsModule.readFileSync(bridgesFile, 'utf8')
+  } catch { return null }
+  let bridges: unknown
+  try { bridges = JSON.parse(raw) } catch { return null }
+  if (bridges === null || typeof bridges !== 'object') return null
+  for (const entry of Object.values(bridges as Record<string, unknown>)) {
+    if (entry === null || typeof entry !== 'object'
+      || typeof (entry as { pid?: unknown }).pid !== 'number' || !dshuiPidAlive((entry as { pid: number }).pid)
+      || typeof (entry as { id?: unknown }).id !== 'string' || (entry as { id: string }).id === ''
+      || typeof (entry as { lastSeen?: unknown }).lastSeen !== 'number' || !dshuiBridgeLeaseLive(entry as { lastSeen: number })
+      || typeof (entry as { workspace?: unknown }).workspace !== 'string' || (entry as { workspace: string }).workspace === ''
+      || typeof (entry as { endpoint?: unknown }).endpoint !== 'string' || (entry as { endpoint: string }).endpoint === ''
+      || typeof (entry as { token?: unknown }).token !== 'string' || (entry as { token: string }).token === '') continue
+    if ((entry as { workspace: string }).workspace === workspace) {
+      return { endpoint: (entry as { endpoint: string }).endpoint, token: (entry as { token: string }).token }
+    }
+  }
+  return null
+}
+
+/** dshui patch: GET one open request to a bridge endpoint. */
+async function dshuiBridgeRequest(target: { endpoint: string; token: string }, path: string, signal: AbortSignal): Promise<boolean> {
+  if (target.endpoint === '') return false
+  try {
+    let url = target.endpoint + '?path=' + encodeURIComponent(path)
+    if (target.token !== '') url += '&token=' + encodeURIComponent(target.token)
+    const response = await fetch(url, { signal })
+    return response.ok
+  } catch (error) {
+    console.warn('[dshui] open bridge request failed:', error)
+    return false
+  }
+}
+
+/** dshui patch: pick the bridge whose workspace is the longest path prefix of the opened file. */
+async function dshuiPickBridgeForPath(path: string): Promise<{ endpoint: string; token: string } | null> {
+  const bridgesFile = process.env.DSHUI_BRIDGES_FILE
+  if (!bridgesFile) return null
+  let fsModule: typeof import('node:fs'), raw: string
+  try {
+    fsModule = await import('node:fs')
+    raw = fsModule.readFileSync(bridgesFile, 'utf8')
+  } catch { return null }
+  let bridges: unknown
+  try { bridges = JSON.parse(raw) } catch { return null }
+  if (bridges === null || typeof bridges !== 'object') return null
+  let best: { workspace: string; endpoint: string; token: string } | null = null
+  for (const entry of Object.values(bridges as Record<string, unknown>)) {
+    if (entry === null || typeof entry !== 'object'
+      || typeof (entry as { pid?: unknown }).pid !== 'number' || !dshuiPidAlive((entry as { pid: number }).pid)
+      || typeof (entry as { id?: unknown }).id !== 'string' || (entry as { id: string }).id === ''
+      || typeof (entry as { lastSeen?: unknown }).lastSeen !== 'number' || !dshuiBridgeLeaseLive(entry as { lastSeen: number })
+      || typeof (entry as { workspace?: unknown }).workspace !== 'string' || (entry as { workspace: string }).workspace === ''
+      || typeof (entry as { endpoint?: unknown }).endpoint !== 'string' || (entry as { endpoint: string }).endpoint === ''
+      || typeof (entry as { token?: unknown }).token !== 'string' || (entry as { token: string }).token === '') continue
+    const ws = (entry as { workspace: string }).workspace
+    if (path === ws || path.startsWith(ws + '/')) {
+      if (best === null || ws.length > best.workspace.length) {
+        best = entry as { workspace: string; endpoint: string; token: string }
+      }
+    }
+  }
+  return best === null ? null : { endpoint: best.endpoint, token: best.token }
+}
+
+/** dshui patch: ask the hosting VS Code (via a window's local open bridge) to
+ * open a path. The click origin is authoritative; workspace routing (longest
+ * prefix, then the owner bridge) applies only when no origin was attached. */
