--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat/UserLink.tsx
@@ -0,0 +1,61 @@
+/**
+ * dshui overlay: one inline `[label](destination)` link inside sent user text.
+ *
+ * An allowlisted absolute URL is an anchor the browser opens; a destination
+ * `new URL` cannot parse is a path the Host resolves against the Session cwd
+ * (with its optional `#L10` / `:10` line reference), opened in the VS Code
+ * editor through the same bridge as every other file link.
+ */
+import type { UserTextNodeProps } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { InjectFace } from '@deepseek-ai/dsh-client-ui-slots'
+import { userLinkDestination } from './user-link-rule.ts'
+import type {} from './user-link-rule.ts'
+import css from './MessageItem.module.css'
+
+/** Navigation seat of one rendered text link. */
+export interface UserLinkInjected {
+  /**
+   * Open a file destination through the Host's workspace-path opener.
+   * @param path - destination as written in the link.
+   * @param line - 1-based line the destination pointed at, when it carried one.
+   */
+  readonly openFile: (path: string, line?: number) => void
+}
+
+/**
+ * Render one claimed markdown link, or its literal syntax when the destination
+ * is outside the allowlist.
+ * @param props - the JSON node, its original spelling, interaction policy, and the navigation seat.
+ * @returns an inline anchor, an inline file button, or the original text.
+ */
+export function UserLink({
+  node, raw, interactive, openFile,
+}: UserTextNodeProps<'link'> & InjectFace<UserLinkInjected>) {
+  const destination = userLinkDestination(node.data.destination)
+  if (destination === null) return <>{raw}</>
+  const label = node.data.label
+  if (destination.kind === 'external') {
+    return interactive
+      ? (
+        <a
+          className={css.link}
+          href={destination.href}
+          {...destination.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
+        >
+          {label}
+        </a>
+      )
+      : <span>{label}</span>
+  }
+  return interactive
+    ? (
+      <button
+        type="button"
+        className={css.link}
+        onClick={() => { openFile(destination.path, destination.line) }}
+      >
+        {label}
+      </button>
+    )
+    : <span>{label}</span>
+}
