+/**
+ * Classification of a `[label](destination)` token's destination in a user
+ * bubble: an allowlisted absolute URL opens externally; anything `new URL`
+ * cannot parse reads as a file path the view's opener resolves against the
+ * session cwd.
+ */
+type UserLinkDestination =
+  | { kind: 'external'; href: string; newTab: boolean }
+  | { kind: 'file'; path: string }
+
+/**
+ * @param raw - The verbatim `(destination)` of a `[label](destination)` token.
+ * @returns the classified destination, or null to keep the syntax literal
+ * (absolute URLs outside the http/https/mailto allowlist).
+ */
+function userLinkDestination(raw: string): UserLinkDestination | null {
+  let protocol: string
+  try {
+    protocol = new URL(raw).protocol
+  } catch {
+    // Unparseable as an absolute URL — a (relative) file path.
+    return { kind: 'file', path: raw }
+  }
+  if (protocol === 'http:' || protocol === 'https:') return { kind: 'external', href: raw, newTab: true }
+  return protocol === 'mailto:' ? { kind: 'external', href: raw, newTab: false } : null
+}
+
+/**
+ * Display projection of sent user text: the upstream reference-chip projection
+ * (wire session form, exact session labels, and plain `/name` / `@name`
+ * tokens) plus `[label](destination)` markdown links (dshui overlay). An
+ * allowlisted absolute URL opens externally; a destination `new URL` cannot
+ * parse reads as a path the view's `openFile` resolves against the session
+ * cwd; any other absolute URL keeps the literal syntax. Everything flows
+ * inline in one pre-wrap span — block boxes would stack every segment.
+ */
+function projectUserTextWithLinks(
+  text: string,
+  referenceLabels: readonly string[],
+  openFile: (path: string) => void,
+): ReactNode {
+  const re = /\[([^\][\n]+)\]\(([^)\s]+)\)/g
+  const parts: ReactNode[] = []
+  let cursor = 0
+  let m: RegExpExecArray | null
+  while ((m = re.exec(text)) !== null) {
+    const destination = userLinkDestination(m[2] ?? '')
+    if (destination === null) continue
+    if (m.index > cursor) parts.push(<span key={`t${cursor}`}>{projectUserText(text.slice(cursor, m.index), referenceLabels)}</span>)
+    parts.push(
+      destination.kind === 'external'
+        ? (
+          <a
+            key={`l${m.index}`}
+            className={css.link}
+            href={destination.href}
+            {...(destination.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
+          >
+            {m[1]}
+          </a>
+        )
+        : (
+          <button
+            key={`l${m.index}`}
+            type="button"
+            className={css.link}
+            onClick={() => { openFile(destination.path) }}
+          >
+            {m[1]}
+          </button>
+        ),
+    )
+    cursor = m.index + m[0].length
+  }
+  if (parts.length === 0) return projectUserText(text, referenceLabels)
+  if (cursor < text.length) parts.push(<span key={`t${cursor}`}>{projectUserText(text.slice(cursor), referenceLabels)}</span>)
+  return <span className={css.projectedText}>{parts}</span>
+}
