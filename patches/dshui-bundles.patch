new file mode 100644
index 0000000000..48f880129a
--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat/user-link-rule.ts
@@ -0,0 +1,89 @@
+/**
+ * dshui overlay: `[label](destination)` markdown links in sent user text.
+ *
+ * The stock user-text projection renders reference chips and plain runs, so a
+ * link the model itself wrote (or the template of a shareable prompt) stayed
+ * literal text. This rule claims those tokens; {@link UserLink} renders them.
+ */
+import type { UserTextRule } from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+declare module '@deepseek-ai/dsh-client-ui-conversation/client' {
+  interface UserTextDataMap {
+    link: {
+      /** Visible label between the brackets. */
+      readonly label: string
+      /** Verbatim `(destination)` payload. */
+      readonly destination: string
+    }
+  }
+}
+
+/** Classification of a destination; `null` keeps the syntax literal. */
+export type UserLinkDestination =
+  | { readonly kind: 'external'; readonly href: string; readonly newTab: boolean }
+  | { readonly kind: 'file'; readonly path: string; readonly line?: number }
+
+/**
+ * Split a file destination off its optional line reference — the two spellings
+ * dsh tells the model to write: the GitHub-style anchor (`a.dart#L10`,
+ * `a.dart#L10-L20`) and the trailing `:line` / `:line-end` / `:line–end`
+ * suffix. Only the first line survives: a range names one file opened at its
+ * start, and the open gesture carries a single line.
+ * @param raw - A destination `new URL` could not parse.
+ * @returns the path without its line reference, plus its 1-based first line.
+ */
+export function filePathAndLine(raw: string): { path: string; line?: number } {
+  const hash = raw.lastIndexOf('#')
+  if (hash !== -1) {
+    const anchored = /^L([1-9][0-9]*)(?:-L?([1-9][0-9]*))?$/.exec(raw.slice(hash + 1))
+    if (anchored !== null) return { path: raw.slice(0, hash), line: Number(anchored[1]) }
+  }
+  const suffixed = /:([1-9][0-9]*)(?:[-–]([1-9][0-9]*))?$/.exec(raw)
+  if (suffixed === null || suffixed.index === 0) return { path: raw }
+  return { path: raw.slice(0, suffixed.index), line: Number(suffixed[1]) }
+}
+
+/**
+ * @param raw - The verbatim `(destination)` of a `[label](destination)` token.
+ * @returns the classified destination, or null to keep the syntax literal
+ * (absolute URLs outside the http/https/mailto allowlist).
+ */
+export function userLinkDestination(raw: string): UserLinkDestination | null {
+  let protocol: string
+  try {
+    protocol = new URL(raw).protocol
+  } catch {
+    // Unparseable as an absolute URL — a (relative) file path carrying an
+    // optional line reference in either spelling.
+    return { kind: 'file', ...filePathAndLine(raw) }
+  }
+  if (protocol === 'http:' || protocol === 'https:') return { kind: 'external', href: raw, newTab: true }
+  return protocol === 'mailto:' ? { kind: 'external', href: raw, newTab: false } : null
+}
+
+/** Candidate grammar of one inline markdown link in original text. */
+const LINK_TOKEN = /\[([^\][\n]+)\]\(([^)\s]+)\)/g
+
+/**
+ * Claim the nearest renderable markdown link at or after `from`. A destination
+ * outside the allowlist is not a link the product can carry, so the syntax
+ * stays literal by skipping that candidate.
+ */
+export const markdownLinkRule: UserTextRule<'link'> = {
+  id: 'link',
+  order: 20,
+  match(text, from) {
+    const tokens = new RegExp(LINK_TOKEN.source, 'g')
+    tokens.lastIndex = from
+    for (let match = tokens.exec(text); match !== null; match = tokens.exec(text)) {
+      if (userLinkDestination(match[2] as string) === null) continue
+      return {
+        id: 'link',
+        start: match.index,
+        end: match.index + match[0].length,
+        data: { label: match[1] as string, destination: match[2] as string },
+      }
+    }
+    return undefined
+  },
+}
