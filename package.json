{
  "name": "dshui-for-vscode",
  "displayName": "dsh UI for VS Code",
  "description": "The DeepSeek Harness (dsh) web UI embedded in VS Code, scoped to the workspace you have open. No workspace selection: the opened folder IS the dsh workspace, the sidebar lists only its sessions, and the input box always stays at the bottom.",
  "version": "1.8.1",
  "publisher": "Leathong",
  "icon": "media/icon.png",
  "author": "Leathong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leathong/dshui-for-vscode.git"
  },
  "homepage": "https://github.com/leathong/dshui-for-vscode",
  "bugs": {
    "url": "https://github.com/leathong/dshui-for-vscode/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshui",
          "title": "dsh",
          "icon": "media/dshui.svg"
        }
      ]
    },
    "views": {
      "dshui": [
        {
          "type": "webview",
          "id": "dshui.view",
          "name": "dsh",
          "icon": "media/dshui.svg"
        }
      ]
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    },
    "commands": [
      {
        "command": "dshui.open",
        "title": "Open",
        "category": "dsh UI"
      },
      {
        "command": "dshui.openInBrowser",
        "title": "Open in Browser",
        "category": "dsh UI"
      },
      {
        "command": "dshui.referenceFile",
        "title": "Add File to dsh",
        "category": "dsh UI"
      },
      {
        "command": "dshui.referenceFolder",
        "title": "Add Folder to dsh",
        "category": "dsh UI"
      },
      {
        "command": "dshui.referenceSelection",
        "title": "Add Selection to dsh",
        "category": "dsh UI"
      },
      {
        "command": "dshui.restartServer",
        "title": "Restart Server",
        "category": "dsh UI"
      },
      {
        "command": "dshui.showLogs",
        "title": "Show Logs",
        "category": "dsh UI"
      },
      {
        "command": "dshui.rollback.accept",
        "title": "Accept This Change",
        "category": "dsh UI"
      },
      {
        "command": "dshui.rollback.undo",
        "title": "Undo This Change",
        "category": "dsh UI"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "dshui.referenceFile",
          "when": "resourceScheme == file && workspaceFolderCount > 0",
          "group": "navigation"
        },
        {
          "command": "dshui.rollback.accept",
          "when": "resourceScheme == dshui-rollback",
          "group": "dshui.rollback@1"
        },
        {
          "command": "dshui.rollback.undo",
          "when": "resourceScheme == dshui-rollback",
          "group": "dshui.rollback@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dshui.referenceFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder && workspaceFolderCount > 0",
          "group": "navigation"
        },
        {
          "command": "dshui.referenceFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder && workspaceFolderCount > 0",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dshui.referenceSelection",
          "when": "editorHasSelection && resourceScheme == file && workspaceFolderCount > 0",
          "group": "navigation"
        },
        {
          "command": "dshui.referenceFile",
          "when": "resourceScheme == file && workspaceFolderCount > 0",
          "group": "navigation"
        },
        {
          "command": "dshui.rollback.accept",
          "when": "resourceScheme == dshui-rollback",
          "group": "dshui.rollback@1"
        },
        {
          "command": "dshui.rollback.undo",
          "when": "resourceScheme == dshui-rollback",
          "group": "dshui.rollback@2"
        }
      ]
    },
    "configuration": {
      "title": "dsh UI",
      "properties": {
        "dshui.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the dsh UI panel when a folder is opened."
        },
        "dshui.server.port": {
          "type": "number",
          "default": 61370,
          "minimum": 0,
          "maximum": 65535,
          "description": "Port for the embedded dsh web server. Defaults to a fixed port (61370) that doubles as the shared-backend rendezvous: all windows reuse ONE server, each scoped to its own workspace, and localStorage is scoped per workspace so each folder remembers its own last-opened session across launches. Set to 0 to let the OS pick a free port (no sharing, no persistence). If the fixed port is occupied, startup reports an error; change this setting and restart."
        },
        "dshui.openFilesInVscode": {
          "type": "boolean",
          "default": true,
          "description": "Open files clicked in the dsh UI inside the current VS Code window (via the vscode://file scheme) instead of the OS default editor."
        },
        "dshui.checkDshUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check the npm registry for newer @deepseek-ai/dsh releases at startup and notify when the bundled version is outdated. Throttled to once per 24h; each new version is announced once."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "copy:clients": "node scripts/copy-clients.mjs",
    "sync:dsh": "node scripts/sync-dsh.mjs",
    "preinstall": "node scripts/sync-dsh.mjs",
    "vscode:prepublish": "npm run compile && npm run copy:clients && npm run sync:dsh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@babel/code-frame": "^7.29.0",
    "@earendil-works/pi-ai": "^0.84.2",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/webhooks": "^14.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.0.0",
    "commander": "^15.0.0",
    "compression": "^1.8.1",
    "diff": "^9.0.0",
    "eventsource-parser": "^3.1.0",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.5.0",
    "js-yaml": "^4.1.0",
    "koffi": "^3.1.0",
    "lexical": "^0.49.0",
    "negotiator": "^1.0.0",
    "node-addon-require-builtin": "^0.1.4",
    "node-pty": "1.2.0-beta.15",
    "open": "^11.0.0",
    "picomatch": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resolve.exports": "^2.0.3",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "use-sync-external-store": "1.2.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
